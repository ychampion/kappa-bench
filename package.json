{
  "name": "kappa-bench",
  "version": "1.0.0",
  "description": "κ-bench: a benchmark for personal agents on everyday work. Same tasks, same model and rules for every bot, blind grading, pass^k, honesty, latency and cost.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "bun run src/cli.ts bench",
    "dry-run": "bun run src/cli.ts dry-run",
    "selftest": "bun run src/selftest.ts",
    "typecheck": "tsc -p .",
    "validate": "bun run src/validate.ts",
    "estimate": "bun run src/estimate.ts",
    "fixtures": "bun run src/cli.ts fixtures",
    "list": "bun run src/cli.ts list",
    "rescore": "bun run src/rescore.ts",
    "leaderboard": "bun run scripts/leaderboard.ts",
    "charts": "bun run scripts/charts.ts",
    "verify-results": "bun run scripts/verify-results.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  }
}
